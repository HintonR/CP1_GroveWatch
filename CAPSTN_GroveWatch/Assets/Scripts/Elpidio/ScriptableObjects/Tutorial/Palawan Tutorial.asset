--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c3a7bbaa64130c4781c9d04ef9e1b1e, type: 3}
  m_Name: Palawan Tutorial
  m_EditorClassIdentifier: 
  cutsceneName: Palawan Tutorial
  lines:
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Rasa Sanctuary
    text: Welcome to Palawan's Rasa Sanctuary! There are more people to please here,
      but first, a quick refresher on the camera controls.
    changeMusic: 1
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Camera/Drone Controls
    text: Press WASD or the Arrow Keys to move your view across the map.
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Camera/Drone Controls
    text: Push your mouse against any edge of the screen and the view will glide
      in that direction.
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Camera/Drone Controls
    text: You may also hold [Right Click] and drag to pull the view where you want
      it.
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Faction Reputation
    text: "In Palawan, both Tourists and Citizens are watching. \nThe new bar shows
      who you're favoring:\nTourists on the left, Citizens on the right."
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Faction Reputation
    text: Every Policy you choose pushes the bar toward one side or the other. Choose
      carefully!
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Faction Reputation
    text: "Happy Tourists bring extra budget every quarter. \nHappy Citizens make
      your reputation grow faster. \nUpset either side, and your reputation will
      drain!"
    changeMusic: 0
    music: 2
  musicOnEnd: 1
  endMusic: 0
  nextSceneName: 
