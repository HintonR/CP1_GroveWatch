MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c3a7bbaa64130c4781c9d04ef9e1b1e, type: 3}
  m_Name: Baguio Tutorial
  m_EditorClassIdentifier: 
  cutsceneName: Baguio Tutorial
  lines:
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Busol Forest
    text: Welcome to Baguio's Busol Forest! The mountains and climate here bring
      a new challenge, but first, a quick refresher on the camera controls.
    changeMusic: 1
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Camera/Drone Controls
    text: Press WASD or the Arrow Keys to move your view across the map.
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Camera/Drone Controls
    text: Push your mouse against any edge of the screen and the view will glide
      in that direction.
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Camera/Drone Controls
    text: You may also hold [Right Click] and drag to pull the view where you want
      it.
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Fog
    text: Baguio gets foggy. Occasionally, fog rolls over the forest and obscures
      your view.
    changeMusic: 0
    music: 2
  - image: {fileID: 21300000, guid: 5f60ac86da50e004289595693fedb7af, type: 3}
    title: Fog
    text: While the fog is up, the quadrant alerts on your right side and the alert
      system goes dark. Check each quadrant yourself and stay vigilant!
    changeMusic: 0
    music: 2
  musicOnEnd: 1
  endMusic: 0
  nextSceneName: 
