%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c3a7bbaa64130c4781c9d04ef9e1b1e, type: 3}
  m_Name: Tutorial
  m_EditorClassIdentifier: 
  cutsceneName: Intro
  lines:
  - image: {fileID: 21300000, guid: 9ecdf0768efb3b8479fcba7044005517, type: 3}
    title: Progress and Reputation
    text: 'In the top center of the screen, there are two

      bars. The blue bar
      corresponds to the DENR''s

      reputation, while the yellow bar corresponds
      to

      the progress towards the DENR''s objective quota.'
    changeMusic: 1
    music: 2
  - image: {fileID: 21300000, guid: 18230166a29b2c44e96683694bb01f8d, type: 3}
    title: Reputation
    text: "When the Reputation bar is empty, the game will be \nover and depending
      on what incidents were failed, \nYou  will see the devastating outcomes of
      your choices."
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: f8a51a71ebb1d684ca6c662af3ee939d, type: 3}
    title: Progress
    text: "Each successful resolution of an incident will increase \nthe progress
      bar. Once the progress bar is full, your \ntenure at the PENRO will be considered
      a success!"
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: 3c0ff2aec21aac44298c42ad7a9f0c95, type: 3}
    title: Time Management
    text: "In the top left are Time Indicators. \nPressing [Space] or the Play/Pause
      Icon \non the Time Dial pauses gameplay. "
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: 66c351e89bd2e4343ab305372efb3dfc, type: 3}
    title: Quadrants
    text: "On the right side are the quadrants that you \nwill be overseeing. You
      may click on a quadrant\nto move there or use [1] [2] [3] [4]."
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: ebea8b9c5fa977d4796aa15e47e88519, type: 3}
    title: Deployment
    text: "In the lower center is your Dispatch Hotbar. \nIncidents are color coded.
      Drag an available unit onto \nan active incident to begin resolving. "
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: fe531459c3cce6d419c778109dd0792f, type: 3}
    title: Budget and Research
    text: "In the lower left is the Budget Display and \nResearch Button. Pressing
      the Research Button\nor [Tab] will bring up the Research Screen. "
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: 2452854c486d52c479ffec81470dacce, type: 3}
    title: Debt
    text: "You may also incur debt; however, if at any point \nyou incur a debt greater
      than 50000php, your tenure \nat the PENRO will immediately cease!"
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: 1ea03c9b1785681438296f1aad4913a3, type: 3}
    title: Policies
    text: 'Every 6 Months, your secretary will inform you about

      political
      events happening in the surrounding area.

      You will need to determine
      the best action to take.'
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: dbd864b06bfd19344a3888d09ed77700, type: 3}
    title: Pause Menu
    text: "If at any point you want to change audio settings\nor quit the game, you
      may press the Gear Button \nor [Esc] to view the Pause Menu."
    changeMusic: 0
    music: 0
  onComplete: 0
  nextSceneName: Intro
  playMode: 1
