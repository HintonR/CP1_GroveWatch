  m_Script: {fileID: 11500000, guid: 4c3a7bbaa64130c4781c9d04ef9e1b1e, type: 3}
  m_Name: Logging Ending
  m_EditorClassIdentifier: 
  cutsceneName: Ending F
  lines:
  - image: {fileID: 21300000, guid: 800f436eb9a4d7f47938ad7bd7ce44a3, type: 3}
    title: 
    text: Poor decisions have led to consistent failures, leaving you feeling frustrated
      and defeated.
    changeMusic: 1
    music: 4
  - image: {fileID: 21300000, guid: b5c98c31670a52644a8042de4f0c3faf, type: 3}
    title: 
    text: Meanwhile, with trust lost, the citizens begin to riot prompting for your
      resignation.
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: dbde05124c805d944b77a1d1acbb2e3d, type: 3}
    title: 
    text: Constant illegal logging removed large portions of the forest, destroying
      habitats and ecological balance.
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: 39dd36bd6d3ccef438644f764b2a3f2a, type: 3}
    title: 
    text: Without trees to stabilize the soil and regulate the environment, the forest
      becomes a husk of its former self.
    changeMusic: 0
    music: 0
  - image: {fileID: 21300000, guid: 7fb966de05974d24592c850ca1952131, type: 3}
    title: 
    text: Due to your failures, you have been forced to resign...
    changeMusic: 0
    music: 0
  onComplete: 0
